# Variáveis novas para a integração Mercado Pago do BarbSist.
# NÃO coloque credenciais reais neste arquivo se ele for versionado.

# URL pública HTTPS do backend Railway, sem barra final.
PUBLIC_BACKEND_URL=https://SEU-BACKEND.up.railway.app

# Chave Fernet usada para criptografar Access Token e Webhook Secret no banco.
# Gere uma vez com: python gerar_chave_mp.py
# Guarde a mesma chave em produção. Se mudar, as credenciais já gravadas não poderão ser descriptografadas.
MP_CREDENTIALS_KEY=COLE_A_CHAVE_GERADA_AQUI
