# Mercado Pago OAuth / Marketplace - BarbSist
# NÃO versionar valores reais.

# Aplicação do BARBSIST criada no painel Mercado Pago Developers.
MP_CLIENT_ID=SEU_APP_ID
MP_CLIENT_SECRET=SEU_CLIENT_SECRET

# Deve ser EXATAMENTE a Redirect URL cadastrada na aplicação Mercado Pago.
# Produção, exemplo:
MP_OAUTH_REDIRECT_URI=https://SEU-BACKEND.up.railway.app/mercado-pago/oauth/callback

# URL pública do backend, usada nos Webhooks de pagamento.
PUBLIC_BACKEND_URL=https://SEU-BACKEND.up.railway.app

# URL do frontend para voltar após conectar/desconectar.
FRONTEND_PUBLIC_URL=https://SEU-FRONTEND.vercel.app

# Chave Fernet para criptografar access_token e refresh_token no banco.
# Gere uma vez com: python gerar_chave_mp.py
MP_CREDENTIALS_KEY=COLE_A_CHAVE_FERNET_AQUI

# Assinatura secreta do Webhook configurado na aplicação Mercado Pago.
# É uma credencial da aplicação BarbSist, não algo que o barbeiro deve digitar.
MP_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET

# PKCE é recomendado pelo Mercado Pago, mas só habilite aqui se também estiver
# habilitado nos detalhes da aplicação Mercado Pago.
MP_OAUTH_USE_PKCE=false
